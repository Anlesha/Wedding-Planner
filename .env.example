# MarryOn Environment Configuration
# When provided, MarryOn can optionally synchronize with a live Supabase PostgreSQL backend.
# If omitted or invalid, MarryOn gracefully runs in rich Local Demo Mode with full local persistence.

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Server-side AI API Key (DO NOT expose private keys in frontend bundles in production)
# VITE_OPENAI_API_KEY=
